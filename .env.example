# Development only. Never use these example credentials in production.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_USER=platform_dev
POSTGRES_PASSWORD=development-only-password
POSTGRES_DB=platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://platform_dev:development-only-password@127.0.0.1:5432/platform
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=platform-dev
STORAGE_SECRET_KEY=development-only-storage-password
STORAGE_BUCKET=platform-attachments
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
READINESS_TIMEOUT_S=3
CORS_ORIGINS=["http://localhost:3000"]
API_UPSTREAM=http://127.0.0.1:8000
GRAFANA_ADMIN_USER=platform-dev
GRAFANA_ADMIN_PASSWORD=development-only-grafana-password
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
EXPO_PUBLIC_API_URL=http://localhost:8000
