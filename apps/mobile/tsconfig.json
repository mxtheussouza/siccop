{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Expo default: React Native, expo-router and config-plugins ship .d.ts files that fail
    // full library checking (91 errors, none in app code). App sources stay strict. See L-122.
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["jest", "node", "react"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "android", "ios"]
}
