{
  "name": "@platform/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "config-check": "expo config --type public",
    "prebuild-check": "expo prebuild --no-install"
  },
  "dependencies": {
    "expo": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-dev-client": "58.0.14",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.24",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.18",
    "jest": "29.7.0",
    "jest-expo": "58.0.11",
    "react-test-renderer": "19.3.0"
  }
}
